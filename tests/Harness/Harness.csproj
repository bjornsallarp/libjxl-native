<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Package smoke test: -p:NativePackageVersion=<v> resolves jxl_native from the
       .nupkg (runtimes/<rid>/native/) instead of JXL_NATIVE_PATH. -->
  <ItemGroup Condition="'$(NativePackageVersion)' != ''">
    <PackageReference Include="MightyLittleJxl.Native" Version="$(NativePackageVersion)" />
  </ItemGroup>

</Project>
