<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Package smoke test: -p:LibJxlNativeVersion=<v> resolves jxl_native from the
       .nupkg (runtimes/<rid>/native/) instead of JXL_NATIVE_PATH. -->
  <ItemGroup Condition="'$(LibJxlNativeVersion)' != ''">
    <PackageReference Include="LibJxl.Native" Version="$(LibJxlNativeVersion)" />
  </ItemGroup>

</Project>
