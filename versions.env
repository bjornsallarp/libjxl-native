# Pinned inputs for build.sh. Bump LIBJXL_TAG and LIBJXL_COMMIT together
# (.github/workflows/update.yml opens a PR for that).
LIBJXL_TAG=v0.12.0
LIBJXL_COMMIT=a7a9c787341cf703dede03c2009fa460cae5e5df
# The package version is LIBJXL_TAG without the v. To repack the same libjxl, add
# e.g. PACKAGE_VERSION=<libjxl version>.1; merging that to main releases it.

MACOS_DEPLOYMENT_TARGET=13.0

# glibc 2.28 floor (AlmaLinux 8), GCC 14.
MANYLINUX_X64_IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:7e41b1c7fd64dfc69703a1124b43c404382973ee06ec5d764b85c34d2221fded
MANYLINUX_ARM64_IMAGE=quay.io/pypa/manylinux_2_28_aarch64@sha256:54b271d9562a3686298880df05367909e949ed317e7b1b79b59c696d75f78676
ALPINE_IMAGE=alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
# Windows cross-compiler (clang 23, UCRT); multi-arch, runs natively on the host.
LLVM_MINGW_IMAGE=mstorsjo/llvm-mingw:20261020@sha256:dadd757c364edee190c53d8e71a135892a6986182e873205d3611f85e26f290b

# Test images (test.sh). Per-architecture digests: Docker Desktop refuses to
# pull a second platform of a multi-arch image already pulled by index digest.
DOTNET_RUNTIME_X64_IMAGE=mcr.microsoft.com/dotnet/runtime@sha256:8ab7af7da9cce3c2b15fa02ae079a4bf96b67a7b723cc80030df9b4090bbed4b
DOTNET_RUNTIME_ARM64_IMAGE=mcr.microsoft.com/dotnet/runtime@sha256:8c006ed69bb9ff5ed814fdb48d7b087bdfc136acdcca8f6fe9d988d9736776e3
DOTNET_RUNTIME_ALPINE_X64_IMAGE=mcr.microsoft.com/dotnet/runtime@sha256:6e19082a0f1a20e1d4dd47bd2372ae1849417ef2b0004d45fe44039efb771a6f
DOTNET_RUNTIME_ALPINE_ARM64_IMAGE=mcr.microsoft.com/dotnet/runtime@sha256:6142948150b21970b8ade72424ef75c3857a362f8b88f046bf292094f10ba51a
